# =====================================================================
# JANANI AGRO PRODUCTS - ENVIRONMENT CONFIGURATION TEMPLATE
#
# Copy this file to ".env" and fill in real values. NEVER commit the real .env.
#
# Production (Hostinger): put the .env ONE LEVEL ABOVE public_html
#   e.g. /home/<user>/domains/jananiagroproducts.com/.env
# so it can never be downloaded. api.php reads it from there automatically
# (fallbacks: public_html/.env, which .htaccess blocks from download).
# Local development: backend/.env
# =====================================================================

# ---- Database (Hostinger hPanel → Databases → MySQL) ----
DB_HOST=localhost
DB_PORT=3306
DB_NAME=your_database_name
DB_USER=your_database_user
DB_PASSWORD=change-me

# ---- Session signing secret (at least 32 random characters) ----
# Generate one with:  php -r "echo bin2hex(random_bytes(32));"
# If empty, api.php generates one and stores it privately in the database.
APP_SECRET=

# ---- Gmail SMTP (OTP codes and order invoices) ----
# Use a Google "App Password" (Google Account → Security → 2-Step Verification → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=your-store-mailbox@gmail.com
SMTP_PASS=your-16-character-app-password

# ---- Administrator mailbox (admin portal sign-in is by e-mail OTP to this address) ----
ADMIN_EMAIL=your-admin-mailbox@gmail.com

# ---- Razorpay (Dashboard → Account & Settings → API Keys, LIVE mode) ----
RAZORPAY_KEY_ID=rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change-me
# Dashboard → Webhooks → URL: https://jananiagroproducts.com/api.php?action=razorpay-webhook
# Events: payment.captured, order.paid, payment.failed
RAZORPAY_WEBHOOK_SECRET=change-me
# Test keys (rzp_test_...) are refused on the live site unless this is set to true (staging only):
RAZORPAY_ALLOW_TEST_MODE=false

# ---- Optional ----
# Extra allowed browser origins for the API (comma separated). Same-origin needs nothing.
CORS_ORIGINS=
# Fast2SMS API key to also send login OTPs by SMS (e-mail delivery works without it)
FAST2SMS_API_KEY=
# Private folder for database snapshots (default: "janani_backups" next to public_html)
BACKUP_DIR=

# ---- Local development only (Express mock API: npm run dev:backend) ----
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
DEV_ADMIN_PASSWORD=
