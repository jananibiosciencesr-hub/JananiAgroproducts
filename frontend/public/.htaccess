# ----------------------------------------------------------------------
# Janani Agro Products - Hostinger Shared/Business Web Hosting Config
# High-Performance Speed, Instant Live Updates & Caching
# ----------------------------------------------------------------------

AddDefaultCharset UTF-8
DirectoryIndex index.html index.php

# Prevent Directory Browsing
Options -Indexes

# Force correct MIME types for Web assets
<IfModule mod_mime.c>
  AddType text/css .css
  AddType application/javascript .js
  AddType application/json .json
  AddType image/svg+xml .svg
  AddType image/webp .webp
  AddType font/woff2 .woff2
  AddType font/woff .woff
</IfModule>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # 1. Allow direct execution of PHP scripts
  RewriteRule ^api\.php$ - [L]
  RewriteRule ^db_init\.php$ - [L]
  RewriteRule ^api/api\.php$ /api.php [QSA,L]
  RewriteRule ^api/db_init\.php$ /db_init.php [QSA,L]

  # 2. Route all /api/admin/* requests directly to api.php REST endpoints
  RewriteRule ^api/admin/([a-zA-Z0-9_-]+)(?:/(.*))?$ /api.php?action=$1&id=$2 [QSA,L]

  # 3. Route all /api/* requests directly to api.php REST endpoints
  RewriteRule ^api/([a-zA-Z0-9_-]+)(?:/(.*))?$ /api.php?action=$1&id=$2 [QSA,L]

  # 4. Allow existing physical files and directories (assets, images, favicon, etc.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 5. SPA Route Fallback: Rewrite all page routes (/about, /cart, /admin, /products, etc.) to index.html
  # Strictly NEVER rewrite assets, images, banners, or static file requests to index.html
  RewriteCond %{REQUEST_URI} !^/api
  RewriteCond %{REQUEST_URI} !^/(assets|images|banners|favicon) [NC]
  RewriteCond %{REQUEST_URI} !\.(css|js|png|jpg|jpeg|gif|svg|ico|webp|woff|woff2|ttf|eot)$ [NC]
  RewriteRule ^ index.html [L]
</IfModule>

# Security: block access to sensitive files
<FilesMatch "(^\.env|\.git|package\.json|tsconfig\.json)">
  Require all denied
</FilesMatch>

# ----------------------------------------------------------------------
# GZIP & DEFLATE COMPRESSION (Maximum Speed for Text & Code)
# ----------------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json application/xml image/svg+xml font/ttf font/otf font/woff font/woff2
</IfModule>

# ----------------------------------------------------------------------
# BROWSER CACHING & INSTANT UPDATE RULES (mod_expires & mod_headers)
# ----------------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"

  # HTML must re-check server instantly so code updates appear immediately
  ExpiresByType text/html "access plus 0 seconds"

  # Immutable Fingerprinted Vite Bundles (JS & CSS have unique hash in filenames)
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"

  # Media & Images
  ExpiresByType image/jpg "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/gif "access plus 1 month"
  ExpiresByType image/webp "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 month"

  # Web Fonts
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  # 1. Instant Live Updates: Never cache HTML files (ensures fresh script hashes load on every visit)
  <FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, no-store, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 2. Immutable Caching: Vite JS & CSS with unique hash in name
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # 3. Optimized Media Caching
  <FilesMatch "\.(jpg|jpeg|png|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  # 4. Fonts
  <FilesMatch "\.(woff|woff2|ttf|otf|eot)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
</IfModule>
