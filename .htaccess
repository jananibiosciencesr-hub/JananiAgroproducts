# ----------------------------------------------------------------------
# Janani Agro Products - Hostinger Shared Hosting Apache/LiteSpeed Config
# ----------------------------------------------------------------------

AddDefaultCharset UTF-8
DirectoryIndex index.html index.php

# Prevent Directory Browsing
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Allow direct access to PHP API endpoints
  RewriteRule ^api\.php$ - [L]
  RewriteRule ^db_init\.php$ - [L]

  # 1. Allow existing files and directories to be served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # 2. Check if a prerendered subfolder index.html exists
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # 3. Fallback: rewrite all other requests to /index.html for client-side routing
  RewriteRule ^ index.html [L]
</IfModule>

# Security: block access to sensitive files
<FilesMatch "(^\.env|\.git|package\.json|tsconfig\.json)">
  Require all denied
</FilesMatch>

# Compression for Speed
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml
</IfModule>
